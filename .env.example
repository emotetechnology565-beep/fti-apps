EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The app reads the two EXPO_PUBLIC_ values above. Supabase Edge Functions receive
# their own SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY defaults.
# Local .env values are not copied into Edge Function Secrets when deploying in the dashboard.
# Never prefix server-only secrets with EXPO_PUBLIC_.
# Add these exact Bunny names in Supabase Edge Functions > Secrets:
# BUNNY_STORAGE_ZONE - Bunny Storage Zone Name
# BUNNY_STORAGE_ACCESS_KEY - Storage Zone Password from Access > API / HTTP
# BUNNY_STORAGE_ENDPOINT - API endpoint shown for the storage zone (include https://)
# BUNNY_CDN_BASE_URL - Pull Zone URL, for example https://your-zone.b-cdn.net
# Phase 5 uses the same Bunny zone, but encrypts RFQ documents before upload.
# Set BUNNY_MEDIA_ENCRYPTION_KEY in Supabase Edge Function Secrets, never EXPO_PUBLIC_.
# Keep this 32-byte base64 key backed up; losing it makes existing attachments unreadable.
BUNNY_MEDIA_ENCRYPTION_KEY=

# Phase 7 scheduled WhatsApp worker. Keep this value only in server-side secrets and Supabase Vault.
OPERATIONS_WORKER_SECRET=
