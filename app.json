{
  "expo": {
    "name": "FTI B2B",
    "slug": "fti-b2b",
    "scheme": "fti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.jpeg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo/logo.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo/logo.jpeg"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "FTI staff can choose product photos for the catalogue.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
